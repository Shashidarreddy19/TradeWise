# ============================================================================
#  TradeWise — Docker Compose Environment Template
#  Copy to .env and fill in your values:
#    cp .env.example .env
# ============================================================================

MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_PORT=3306
BACKEND_PORT=8081
FRONTEND_PORT=80

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Optional — get from https://build.nvidia.com
NVIDIA_API_KEY=

# Optional — extra CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=

# "update" on first deploy, "none" after pipeline populates TradeData DB
TRADEDATA_DDL_AUTO=update
