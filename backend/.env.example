# ============================================================================
#  CBEC-AI Backend — Environment Variable Template
#  Copy this file to ".env" and fill in real values. The .env file is
#  git-ignored and loaded automatically at startup (spring-dotenv).
# ============================================================================

# ── NVIDIA AI / RAG ─────────────────────────────────────────────────────────
# API key entitled for the three models below. Get one at https://build.nvidia.com
NVIDIA_API_KEY=

# Endpoints
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-vl-1b-v2/reranking

# Active models
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2

# LLM tuning
NVIDIA_LLM_MAX_TOKENS=4096
NVIDIA_LLM_TEMPERATURE=0.2
NVIDIA_LLM_TOP_P=0.95
NVIDIA_LLM_ENABLE_THINKING=false
NVIDIA_LLM_REASONING_BUDGET=4096

# RAG tuning
RAG_VECTOR_TOP_K=12
RAG_RERANK_TOP_N=6
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200

# ── Databases (MySQL) ───────────────────────────────────────────────────────
DB_MAIN_USERNAME=root
DB_MAIN_PASSWORD=
DB_TRADEDATA_USERNAME=root
DB_TRADEDATA_PASSWORD=

# ── Security ────────────────────────────────────────────────────────────────
# Must be >= 32 characters for JWT HS256. Avoid '#' and '$' (special in .env).
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
